def resolve_project_path(
    path_value: str,
) -> Path:
    """Résoudre un chemin relativement au projet."""

    path = Path(path_value)

    if not path.is_absolute():
        path = PROJECT_ROOT / path

    return path.resolve()


def sha256_file(path: Path) -> str:
    """Calculer l'empreinte SHA-256."""

    digest = hashlib.sha256()

    with path.open("rb") as source:
        for block in iter(
            lambda: source.read(1024 * 1024),
            b"",
        ):
            digest.update(block)

    return digest.hexdigest()


def write_jsonl(
    records: list[EvaluationQuery],
    path: Path,
) -> None:
    """Écrire les questions au format JSONL."""

    temporary_path = path.with_suffix(
        path.suffix + ".tmp"
    )

    with temporary_path.open(
        "w",
        encoding="utf-8",
        newline="\n",
    ) as output:
        for record in records:
            output.write(
                json.dumps(
                    record.model_dump(mode="json"),
                    ensure_ascii=False,
                )
                + "\n"
            )

    temporary_path.replace(path)


def write_json(
    data: dict[str, Any],
    path: Path,
) -> None:
    """Écrire un objet JSON atomiquement."""

    temporary_path = path.with_suffix(
        path.suffix + ".tmp"
    )

    temporary_path.write_text(
        json.dumps(
            data,
            ensure_ascii=False,
            indent=2,
        ),
        encoding="utf-8",
    )

    temporary_path.replace(path)


def validate_expected_counts(
    queries: list[EvaluationQuery],
    expected: Any,
) -> None:
    """Comparer le seed aux comptages configurés."""

    if len(queries) != expected.total_queries:
        raise ValueError(
            f"Nombre de questions incorrect : {len(queries)} "
            f"!= {expected.total_queries}."
        )

    answerable_count = sum(
        query.answerable
        for query in queries
    )

    if answerable_count != expected.answerable_queries:
        raise ValueError(
            "Nombre de questions répondables incorrect : "
            f"{answerable_count} != "
            f"{expected.answerable_queries}."
        )

    unanswerable_count = (
        len(queries) - answerable_count
    )

    if (
        unanswerable_count
        != expected.unanswerable_queries
    ):
        raise ValueError(
            "Nombre de questions non répondables incorrect : "
            f"{unanswerable_count} != "
            f"{expected.unanswerable_queries}."
        )

    split_counts = Counter(
        query.split.value
        for query in queries
    )

    if dict(split_counts) != expected.splits:
        raise ValueError(
            "Répartition des splits incorrecte : "
            f"{dict(split_counts)} != {expected.splits}."
        )

    category_counts = Counter(
        query.category.value
        for query in queries
    )

    if dict(category_counts) != expected.categories:
        raise ValueError(
            "Répartition des catégories incorrecte : "
            f"{dict(category_counts)} != "
            f"{expected.categories}."
        )


def parse_arguments() -> argparse.Namespace:
    """Lire les arguments."""

    parser = argparse.ArgumentParser(
        description=(
            "Créer le benchmark retrieval PhosProcess v0.1."
        )
    )

    parser.add_argument(
        "--force",
        action="store_true",
        help=(
            "Supprimer et recréer le répertoire de sortie. "
            "Cette option efface aussi les jugements existants."
        ),
    )

    return parser.parse_args()


def main() -> None:
    """Créer le dataset initial."""

    arguments = parse_arguments()

    config = load_evaluation_config(
        CONFIG_PATH
    )

    output_directory = resolve_project_path(
        config.dataset.output_directory
    )

    if output_directory.exists():
        if not arguments.force:
            raise FileExistsError(
                "Le dataset existe déjà : "
                f"{output_directory}\n"
                "Utilise --force uniquement pour le recréer "
                "et effacer les annotations existantes."
            )

        shutil.rmtree(output_directory)

    output_directory.mkdir(
        parents=True,
        exist_ok=False,
    )

    queries = build_queries()

    validate_expected_counts(
        queries,
        config.expected,
    )

    query_ids = [
        query.query_id
        for query in queries
    ]

    expected_query_ids = [
        f"Q{index:03d}"
        for index in range(
            1,
            len(queries) + 1,
        )
    ]

    if query_ids != expected_query_ids:
        raise ValueError(
            "Les query_id doivent être continus de "
            "Q001 à Q048."
        )

    queries_path = (
        output_directory
        / config.dataset.queries_filename
    )

    judgments_path = (
        output_directory
        / config.dataset.judgments_filename
    )

    manifest_path = (
        output_directory
        / config.dataset.manifest_filename
    )

    write_jsonl(
        queries,
        queries_path,
    )

    judgments_path.write_text(
        "",
        encoding="utf-8",
    )

    split_counts = Counter(
        query.split.value
        for query in queries
    )

    category_counts = Counter(
        query.category.value
        for query in queries
    )

    language_counts = Counter(
        query.language.value
        for query in queries
    )

    difficulty_counts = Counter(
        query.difficulty.value
        for query in queries
    )

    manifest: dict[str, Any] = {
        "dataset": {
            "name": config.dataset.name,
            "version": config.dataset.version,
            "schema_version": (
                config.dataset.schema_version
            ),
            "status": "draft_queries_created",
        },
        "created_at_utc": datetime.now(UTC).isoformat(),
        "pipeline_version": config.pipeline_version,
        "counts": {
            "total_queries": len(queries),
            "answerable": sum(
                query.answerable
                for query in queries
            ),
            "unanswerable": sum(
                not query.answerable
                for query in queries
            ),
            "judgments": 0,
            "splits": dict(split_counts),
            "categories": dict(category_counts),
            "languages": dict(language_counts),
            "difficulties": dict(
                difficulty_counts
            ),
        },
        "reference_documents": sorted(
            {
                document_id
                for query in queries
                for document_id
                in query.reference_documents
            }
        ),
        "files": {
            "queries": {
                "filename": queries_path.name,
                "sha256": sha256_file(queries_path),
                "size_bytes": queries_path.stat().st_size,
            },
            "judgments": {
                "filename": judgments_path.name,
                "sha256": sha256_file(
                    judgments_path
                ),
                "size_bytes": (
                    judgments_path.stat().st_size
                ),
            },
        },
        "configuration": {
            "path": str(CONFIG_PATH),
            "sha256": sha256_file(CONFIG_PATH),
        },
    }

    write_json(
        manifest,
        manifest_path,
    )

    print("\n=== Dataset d'évaluation créé ===")
    print(f"Répertoire    : {output_directory}")
    print(f"Questions     : {len(queries)}")
    print(
        "Répondables   : "
        f"{manifest['counts']['answerable']}"
    )
    print(
        "Non répondables: "
        f"{manifest['counts']['unanswerable']}"
    )
    print(f"Splits        : {dict(split_counts)}")
    print(
        f"Catégories    : {dict(category_counts)}"
    )
    print(f"Langues       : {dict(language_counts)}")
    print(f"Questions     : {queries_path}")
    print(f"Jugements     : {judgments_path}")
    print(f"Manifest      : {manifest_path}")


if __name__ == "__main__":
    main()