)

BECKER = "01_becker_phosphates_and_phosphoric_acid"
JACOBS = "02_jacobs_largest_phosphoric_acid_plant"
UNIDO = "03_unido_phosphate_process_technologies"
WORKSHOP = "04_rapport_atelier_acide_phosphorique"


def answered(
    index: int,
    question: str,
    language: QueryLanguage,
    category: QueryCategory,
    difficulty: QueryDifficulty,
    split: DatasetSplit,
    family: str,
    expected_answer: str,
    references: list[str],
    notes: str = "",
) -> EvaluationQuery:
    """Créer une question répondable."""

    return EvaluationQuery(
        query_id=f"Q{index:03d}",
        question=question,
        language=language,
        category=category,
        difficulty=difficulty,
        answerable=True,
        split=split,
        question_family_id=family,
        expected_answer=expected_answer,
        notes=notes,
        reference_documents=references,
    )


def unanswered(
    index: int,
    question: str,
    language: QueryLanguage,
    difficulty: QueryDifficulty,
    split: DatasetSplit,
    family: str,
    notes: str,
) -> EvaluationQuery:
    """Créer une question volontairement non répondable."""

    return EvaluationQuery(
        query_id=f"Q{index:03d}",
        question=question,
        language=language,
        category=QueryCategory.UNANSWERABLE,
        difficulty=difficulty,
        answerable=False,
        split=split,
        question_family_id=family,
        expected_answer=None,
        notes=notes,
        reference_documents=[],
    )


