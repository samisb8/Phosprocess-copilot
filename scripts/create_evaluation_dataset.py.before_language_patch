from phosprocess.evaluation.schemas import (
    DatasetSplit,
    EvaluationQuery,
    QueryCategory,
    QueryDifficulty,
    QueryLanguage,
    load_evaluation_config,
)

PROJECT_ROOT = Path(__file__).resolve().parents[1]

CONFIG_PATH = (
    PROJECT_ROOT
    / "configs"
